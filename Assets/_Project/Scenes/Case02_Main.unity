    suspectPortrait: {fileID: 2039676205718866816, guid: c67f5c6b70dd35948b52d7cc9ac5753d, type: 3}
    detectiveAskMale: {fileID: 1737174235}
    detectiveAskFemale: {fileID: 837722910}
    suspectVoiceAudio: {fileID: 338024924}
    detectiveDialogueText: Elena, potassium cyanide was found in Dr. King's mug, and batch BIO-772 was checked out under your badge. You poisoned him for the quantum chip, didn't you?
    suspectDialogueText: Alright, alright! Yes, I took the vial! But Dr. King was going to sell our life's research to offshore syndicates! I had to protect our breakthrough!
