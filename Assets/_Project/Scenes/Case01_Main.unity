--- !u!114 &436929384
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 436929381}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 00ba36d0dde27d24f82c0ef7a9890da5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SeparateInterrogationManager
  suspect1:
    suspectName: Evan Hart
    suspectObject: {fileID: 1233100195}
    chairTarget: {fileID: 1647257556}
    suspectCamera: {fileID: 330585545}
    suspectPortrait: {fileID: 2590121644143778945, guid: 8bfeb21a7dd943b46b65b3be995508de, type: 3}
    detectiveAskMale: {fileID: 1979867624}
    detectiveAskFemale: {fileID: 323645273}
    suspectVoiceAudio: {fileID: 1048776094}
    detectiveDialogueText: Evan, you claimed you left before 9.30 and never touched the cabinet.  But our evidence proves otherwise. Care to explain?
    suspectDialogueText: Alright. I opened it, but I received a message telling me to move the package to the apartment. I had no idea what was going on.
    agent: {fileID: 0}
    animator: {fileID: 0}
    suspectCollider: {fileID: 0}
    hasReached: 0
    initialPosition: {x: 0, y: 0, z: 0}
    isLeaving: 0
    hasLeft: 0
    isWaitingForInteraction: 0
    actionTime: 0
  suspect2:
    suspectName: Nora Blake
    suspectObject: {fileID: 1459782732}
    chairTarget: {fileID: 1647257556}
    suspectCamera: {fileID: 330585545}
    suspectPortrait: {fileID: 2039676205718866816, guid: c67f5c6b70dd35948b52d7cc9ac5753d, type: 3}
    detectiveAskMale: {fileID: 1737174235}
    detectiveAskFemale: {fileID: 837722910}
    suspectVoiceAudio: {fileID: 338024924}
    detectiveDialogueText: Nora, you told us you saw someone in a dark jacket. But your keycard log shows you entered the office at 2.15. You were there, weren't you?
    suspectDialogueText: Alright, alright. My keycard log doesn't lie. I entered the office at 2.15, but I didn't pull the trigger. I swear.
    agent: {fileID: 0}
    animator: {fileID: 0}
    suspectCollider: {fileID: 0}
    hasReached: 0
    initialPosition: {x: 0, y: 0, z: 0}
    isLeaving: 0
    hasLeft: 0
    isWaitingForInteraction: 0
    actionTime: 0
